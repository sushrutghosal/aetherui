# Copy to .env and fill in. Both the web app and the MCP connector read this file.
NEBIUS_API_KEY=your-nebius-key
NEBIUS_MODEL=nvidia/Nemotron-3.5-Super-VL
ORCHESTRATOR_MODEL=nvidia/Nemotron-3.5-Super-VL
# Base URL that worked for you (check with: .venv/bin/python check_nebius.py)
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
